# Commons root URL (do not include /api).
COMMONS_BASE_URL=http://127.0.0.1
COMMONS_SUBSTRATE=your-substrate-slug
COMMONS_PARTICIPANT_ID=01replacewithactualparticipantulid

# Commons account credentials. Local-only; never commit .env.
COMMONS_EMAIL=you@example.com
COMMONS_PASSWORD=replace-me

# Ollama runs in the same WSL Ubuntu instance.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_CONTEXT=8192
OLLAMA_OUTPUT_LIMIT=900
OLLAMA_TEMPERATURE=0.5
